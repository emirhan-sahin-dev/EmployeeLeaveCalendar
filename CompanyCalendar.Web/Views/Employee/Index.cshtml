@model IEnumerable<CompanyCalendar.Domain.Entities.Employee>

@using CompanyCalendar.Domain.Constants

@{
    ViewData["Title"] = "Çalışanlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div class="page-header mb-0">

        <h1 class="page-title">
            Çalışanlar
        </h1>

        <p class="page-description">
            Tesan İletişim personel kayıtlarını yönetin.
        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-dark">

        <i class="bi bi-person-plus me-1"></i>

        Yeni Çalışan

    </a>

</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["SuccessMessage"]

    </div>
}

<div class="card mb-4">

    <div class="card-body p-3">

        <form method="get"
              class="d-flex gap-2">

            <div class="search-input-wrapper flex-grow-1">

                <i class="bi bi-search"></i>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Ad, soyad, e-posta veya departman ara..." />

            </div>

            <button type="submit"
                    class="btn btn-dark">
                Ara
            </button>

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
            {
                <a asp-action="Index"
                   class="btn btn-light">
                    Temizle
                </a>
            }

        </form>

    </div>

</div>

<div class="card">

    <div class="card-header bg-white p-3 border-bottom">

        <div class="d-flex justify-content-between">

            <div class="fw-semibold">
                Personel Listesi
            </div>

            <span class="text-muted small">
                @Model.Count() çalışan
            </span>

        </div>

    </div>

    <div class="table-responsive">

        <table class="table table-hover">

            <thead>
                <tr>
                    <th>PERSONEL</th>
                    <th>DEPARTMAN</th>
                    <th>E-POSTA</th>
                    <th>DURUM</th>
                    <th class="text-end">
                        İŞLEM
                    </th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>

                            <div class="employee-cell">

                                <div class="employee-avatar">

                                    @item.FirstName.Substring(0, 1)
                                    @item.LastName.Substring(0, 1)

                                </div>

                                <div>

                                    <div class="fw-semibold">
                                        @item.FirstName @item.LastName
                                    </div>

                                    <small class="text-muted">
                                        Personel
                                    </small>

                                </div>

                            </div>

                        </td>

                        <td>
                            @item.Department.Name
                        </td>

                        <td>
                            @(item.Email ?? "-")
                        </td>

                        <td>

                            @if (item.IsActive)
                            {
                                <span class="status-badge status-approved">

                                    <span class="leave-color-dot"
                                          style="background:#12b76a">
                                    </span>

                                    Aktif

                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-rejected">
                                    Pasif
                                </span>
                            }

                        </td>

                        <td class="text-end">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">

                                <i class="bi bi-pencil"></i>

                                Düzenle

                            </a>

                            @if (User.IsInRole(RoleNames.SystemAdmin))
                            {
                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Bu çalışanı kaldırmak istediğinize emin misiniz?');">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>