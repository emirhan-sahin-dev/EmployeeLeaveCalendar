@{
    ViewData["Title"] = "İzin Takvimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="page-header mb-0">
        <h1 class="page-title">
            İzin Takvimi
        </h1>
        <p class="page-description">
            Onaylanmış personel izinlerini takvim üzerinden görüntüleyin.
        </p>
    </div>

    <a asp-controller="LeaveRequest"
       asp-action="Create"
       class="btn btn-dark">
        <i class="bi bi-plus-lg me-1"></i>
        Yeni İzin
    </a>
</div>

<div class="card mb-4">

    <div class="card-body p-3">

        <div class="d-flex align-items-end gap-3">

            <div style="min-width:220px;">

                <label class="form-label">
                    Departman
                </label>

                <select id="departmentFilter"
                        class="form-select">

                    <option value="">
                        Tüm Departmanlar
                    </option>

                    @foreach (var department in ViewBag.Departments)
                    {
                        <option value="@department.Id">
                            @department.Name
                        </option>
                    }

                </select>

            </div>

            <div style="min-width:220px;">

                <label class="form-label">
                    İzin Türü
                </label>

                <select id="leaveTypeFilter"
                        class="form-select">

                    <option value="">
                        Tüm İzin Türleri
                    </option>

                    @foreach (var leaveType in ViewBag.LeaveTypes)
                    {
                        <option value="@leaveType.Id">
                            @leaveType.Name
                        </option>
                    }

                </select>

            </div>

            <button id="clearCalendarFilters"
                    class="btn btn-light">

                <i class="bi bi-arrow-counterclockwise me-1"></i>

                Filtreleri Temizle

            </button>

        </div>

    </div>

</div>

<div class="card">
    <div class="card-body p-4">
        <div id="calendar"></div>
    </div>
</div>

<div class="modal fade"
     id="eventModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    İzin Detayı
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <small class="text-muted">
                        Çalışan
                    </small>
                    <div class="fw-semibold"
                         id="modalEmployee">
                    </div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">
                        Departman
                    </small>
                    <div id="modalDepartment">
                    </div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">
                        İzin Türü
                    </small>
                    <div id="modalLeaveType">
                    </div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">
                        Tarih
                    </small>
                    <div id="modalDates">
                    </div>
                </div>

                <div>
                    <small class="text-muted">
                        Açıklama
                    </small>
                    <div id="modalDescription">
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Kapat
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/locales-all.global.min.js"></script>

    <script>
        document.addEventListener(
            'DOMContentLoaded',
            function () {

                const calendarElement =
                    document.getElementById('calendar');

                const calendar =
                    new FullCalendar.Calendar(
                        calendarElement,
                        {
                            initialView: 'dayGridMonth',

                            locale: 'tr',

                            firstDay: 1,

                            height: 'auto',

                            headerToolbar: {
                                left: 'prev,next today',
                                center: 'title',
                                right: 'dayGridMonth,timeGridWeek,listMonth'
                            },

                            buttonText: {
                                today: 'Bugün',
                                month: 'Ay',
                                week: 'Hafta',
                                list: 'Liste'
                            },

                            events: function(fetchInfo, successCallback, failureCallback) {

                                const departmentId =
                                    document.getElementById('departmentFilter').value;

                                const leaveTypeId =
                                    document.getElementById('leaveTypeFilter').value;

                                const params = new URLSearchParams({
                                    start: fetchInfo.startStr,
                                    end: fetchInfo.endStr
                                });

                                if (departmentId) {
                                    params.append(
                                        'departmentId',
                                        departmentId
                                    );
                                }

                                if (leaveTypeId) {
                                    params.append(
                                        'leaveTypeId',
                                        leaveTypeId
                                    );
                                }

                                fetch(
                                    '@Url.Action("GetEvents", "Calendar")?' +
                                    params.toString()
                                )
                                .then(response => {

                                    if (!response.ok) {
                                        throw new Error(
                                            'Takvim verileri alınamadı.'
                                        );
                                    }

                                    return response.json();
                                })
                                .then(data => {
                                    successCallback(data);
                                })
                                .catch(error => {
                                    console.error(error);
                                    failureCallback(error);
                                });
                            },

                            eventDisplay: 'block',

                            eventClick: function (info) {

                                const props =
                                    info.event.extendedProps;

                                document.getElementById(
                                    'modalEmployee'
                                ).textContent =
                                    props.employeeName;

                                document.getElementById(
                                    'modalDepartment'
                                ).textContent =
                                    props.department;

                                document.getElementById(
                                    'modalLeaveType'
                                ).textContent =
                                    props.leaveType;

                                document.getElementById(
                                    'modalDates'
                                ).textContent =
                                    props.startDate +
                                    ' - ' +
                                    props.endDate;

                                document.getElementById(
                                    'modalDescription'
                                ).textContent =
                                    props.description;

                                const modal =
                                    new bootstrap.Modal(
                                        document.getElementById(
                                            'eventModal'
                                        )
                                    );

                                modal.show();
                            }
                        }
                    );

                calendar.render();

                document.getElementById(
                    'departmentFilter'
                ).addEventListener(
                    'change',
                    function () {
                        calendar.refetchEvents();
                    }
                );

                document.getElementById(
                    'leaveTypeFilter'
                ).addEventListener(
                    'change',
                    function () {
                        calendar.refetchEvents();
                    }
                );

                document.getElementById(
                    'clearCalendarFilters'
                ).addEventListener(
                    'click',
                    function () {

                        document.getElementById(
                            'departmentFilter'
                        ).value = '';

                        document.getElementById(
                            'leaveTypeFilter'
                        ).value = '';

                        calendar.refetchEvents();
                    }
                );
            }
        );
    </script>
}