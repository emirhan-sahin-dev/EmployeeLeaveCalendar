@model IEnumerable<CompanyCalendar.Domain.Entities.LeaveType>

@using CompanyCalendar.Domain.Constants

@{
    ViewData["Title"] = "İzin Türleri";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div class="page-header mb-0">

        <h1 class="page-title">
            İzin Türleri
        </h1>

        <p class="page-description">
            Takvim ve izin taleplerinde kullanılan izin türlerini yönetin.
        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-dark">

        <i class="bi bi-plus-lg me-1"></i>

        Yeni İzin Türü

    </a>

</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card">

    <div class="table-responsive">

        <table class="table table-hover">

            <thead>
                <tr>
                    <th>İZİN TÜRÜ</th>
                    <th>TAKVİM RENGİ</th>
                    <th>DURUM</th>
                    <th class="text-end">
                        İŞLEM
                    </th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td class="fw-semibold">
                            @item.Name
                        </td>

                        <td>

                            <span class="leave-color-preview"
                                  style="background:@item.Color">
                            </span>

                            <span class="ms-2 text-muted">
                                @item.Color
                            </span>

                        </td>

                        <td>

                            @if (item.IsActive)
                            {
                                <span class="status-badge status-approved">
                                    Aktif
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-rejected">
                                    Pasif
                                </span>
                            }

                        </td>

                        <td class="text-end">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">

                                <i class="bi bi-pencil"></i>

                                Düzenle

                            </a>

                            @if (User.IsInRole(RoleNames.SystemAdmin))
                            {
                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('İzin türünü kaldırmak istediğinize emin misiniz?');">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>