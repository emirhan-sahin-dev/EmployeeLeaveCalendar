@using CompanyCalendar.Domain.Constants

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Tesan İletişim
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/CompanyCalendar.Web.styles.css"
          asp-append-version="true" />
</head>

<body>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-wrapper">

            <!-- SIDEBAR -->
            <aside class="app-sidebar"
                   id="sidebar">

                <div class="sidebar-brand">

                    <div class="tesan-logo">
                        TESAN
                    </div>

                    <div class="sidebar-system-name">
                        İzin Yönetim Sistemi
                    </div>

                </div>

                <nav class="sidebar-navigation">

                    <div class="sidebar-section-title">
                        ANA MENÜ
                    </div>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="sidebar-link">

                        <i class="bi bi-grid-1x2-fill"></i>

                        <span>Genel Bakış</span>

                    </a>

                    <a asp-controller="Calendar"
                       asp-action="Index"
                       class="sidebar-link">

                        <i class="bi bi-calendar3"></i>

                        <span>İzin Takvimi</span>

                    </a>

                    <a asp-controller="LeaveRequest"
                       asp-action="Index"
                       class="sidebar-link">

                        <i class="bi bi-file-earmark-check"></i>

                        <span>İzin Talepleri</span>

                    </a>

                    <a asp-controller="Employee"
                       asp-action="Index"
                       class="sidebar-link">

                        <i class="bi bi-people"></i>

                        <span>Çalışanlar</span>

                    </a>

                    @if (User.IsInRole(RoleNames.SystemAdmin) ||
                                    User.IsInRole(RoleNames.HumanResources))
                    {
                        <div class="sidebar-section-title mt-4">
                            YÖNETİM
                        </div>

                        <a asp-controller="Department"
                           asp-action="Index"
                           class="sidebar-link">

                            <i class="bi bi-diagram-3"></i>

                            <span>Departmanlar</span>

                        </a>

                        <a asp-controller="LeaveType"
                           asp-action="Index"
                           class="sidebar-link">

                            <i class="bi bi-tags"></i>

                            <span>İzin Türleri</span>

                        </a>
                    }

                </nav>

                <div class="sidebar-footer">

                    <div class="sidebar-company">
                        <i class="bi bi-building"></i>

                        <div>
                            <div class="fw-semibold">
                                Tesan İletişim A.Ş.
                            </div>

                            <small>
                                Personel Yönetimi
                            </small>
                        </div>
                    </div>

                </div>

            </aside>

            <!-- ANA ALAN -->
            <main class="app-main">

                <!-- TOPBAR -->
                <header class="app-topbar">

                    <div class="d-flex align-items-center">

                        <button class="mobile-menu-button"
                                id="mobileMenuButton"
                                type="button">

                            <i class="bi bi-list"></i>

                        </button>

                        <div>
                            <div class="topbar-title">
                                Personel İzin Yönetimi
                            </div>

                            <div class="topbar-subtitle">
                                Tesan İletişim
                            </div>
                        </div>

                    </div>

                    <div class="topbar-user">

                        <div class="user-avatar">
                            <i class="bi bi-person"></i>
                        </div>

                        <div class="user-information">

                            <div class="user-name">
                                @User.Identity.Name
                            </div>

                            <div class="user-role">
                                @if (User.IsInRole(RoleNames.SystemAdmin))
                                {
                                    <span>Sistem Yöneticisi</span>
                                }
                                else if (User.IsInRole(RoleNames.HumanResources))
                                {
                                    <span>İnsan Kaynakları</span>
                                }
                            </div>

                        </div>

                        <div class="dropdown">

                            <button class="user-menu-button"
                                    type="button"
                                    data-bs-toggle="dropdown">

                                <i class="bi bi-chevron-down"></i>

                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                                <li>
                                    <span class="dropdown-item-text small text-muted">
                                        @User.Identity.Name
                                    </span>
                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>
                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post">

                                        <button type="submit"
                                                class="dropdown-item text-danger">

                                            <i class="bi bi-box-arrow-right me-2"></i>

                                            Çıkış Yap

                                        </button>

                                    </form>
                                </li>

                            </ul>

                        </div>

                    </div>

                </header>

                <!-- PAGE CONTENT -->
                <div class="app-content">

                    @RenderBody()

                </div>

            </main>

        </div>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sidebar =
            document.getElementById('sidebar');

        const mobileMenuButton =
            document.getElementById('mobileMenuButton');

        if (mobileMenuButton && sidebar) {

            mobileMenuButton.addEventListener(
                'click',
                function () {

                    sidebar.classList.toggle(
                        'sidebar-mobile-open'
                    );

                }
            );

        }

        document.querySelectorAll(
            '.sidebar-link'
        ).forEach(link => {

            const currentPath =
                window.location.pathname.toLowerCase();

            const linkPath =
                link.getAttribute('href')?.toLowerCase();

            if (linkPath &&
                linkPath !== '/' &&
                currentPath.startsWith(linkPath)) {

                link.classList.add('active');

            }

            if (currentPath === '/' &&
                linkPath === '/') {

                link.classList.add('active');

            }

        });
    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false)

</body>
</html>