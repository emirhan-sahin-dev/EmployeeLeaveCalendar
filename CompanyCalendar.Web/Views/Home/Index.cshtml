@model CompanyCalendar.Web.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">
        Tesan İletişim
    </h2>

    <p class="text-muted mb-0">
        Personel İzin Takip Sistemi
    </p>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">

    <!-- AKTİF ÇALIŞAN -->
    <div class="col-sm-6 col-xl-3">
        <div class="dashboard-stat-card">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="bi bi-people"></i>
                </div>
                <span class="stat-label">
                    Aktif Çalışan
                </span>
            </div>
            <div class="stat-number">
                @Model.TotalActiveEmployees
            </div>
            <div class="stat-description">
                Sistemdeki toplam çalışan
            </div>
        </div>
    </div>

    <!-- BUGÜN İZİNLİ -->
    <div class="col-sm-6 col-xl-3">
        <div class="dashboard-stat-card">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <span class="stat-label">
                    Bugün İzinli
                </span>
            </div>
            <div class="stat-number">
                @Model.EmployeesOnLeaveToday
            </div>
            <div class="stat-description">
                Şu an izinde olanlar
            </div>
        </div>
    </div>

    <!-- ÇALIŞACAK -->
    <div class="col-sm-6 col-xl-3">
        <div class="dashboard-stat-card">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="bi bi-person-check"></i>
                </div>
                <span class="stat-label">
                    Bugün Çalışacak
                </span>
            </div>
            <div class="stat-number">
                @Model.EmployeesWorkingToday
            </div>
            <div class="stat-description">
                Aktif çalışan sayısı
            </div>
        </div>
    </div>

    <!-- BEKLEYEN -->
    <div class="col-sm-6 col-xl-3">
        <div class="dashboard-stat-card">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <span class="stat-label">
                    Onay Bekleyen
                </span>
            </div>
            <div class="stat-number">
                @Model.PendingLeaveRequests
            </div>
            <div class="stat-description">
                İşlem bekleyen izin talebi
            </div>
        </div>
    </div>

</div>

<!-- BUGÜN İZİNLİ OLANLAR TABLOSU -->
<div class="row g-4">
    <div class="col-lg-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">
                            Bugün İzinli Olanlar
                        </h5>
                        <small class="text-muted">
                            @DateTime.Today.ToString("dd.MM.yyyy")
                        </small>
                    </div>

                    <a asp-controller="Calendar"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-dark">
                        Takvimi Aç
                    </a>
                </div>
            </div>

            <div class="card-body p-0">
                @if (!Model.TodayLeaves.Any())
                {
                    <div class="text-center py-5">
                        <h6 class="fw-semibold">
                            Bugün izinli çalışan bulunmuyor.
                        </h6>
                        <p class="text-muted mb-0">
                            Tüm aktif çalışanlar çalışıyor görünüyor.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Çalışan</th>
                                    <th>Departman</th>
                                    <th>İzin Türü</th>
                                    <th>Başlangıç</th>
                                    <th>Bitiş</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TodayLeaves)
                                {
                                    <tr>
                                        <td>
                                            <div class="employee-cell">
                                                <div class="employee-avatar">
                                                    @item.Employee.FirstName.Substring(0, 1)@item.Employee.LastName.Substring(0, 1)
                                                </div>
                                                <div>
                                                    <div class="fw-semibold">
                                                        @item.Employee.FirstName @item.Employee.LastName
                                                    </div>
                                                    <small class="text-muted">
                                                        @item.Employee.Email
                                                    </small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @item.Employee.Department.Name
                                        </td>
                                        <td>
                                            <span class="leave-type-indicator" style="--leave-color:@item.LeaveType.Color">
                                                <span class="leave-color-dot"></span>
                                                @item.LeaveType.Name
                                            </span>
                                        </td>
                                        <td>
                                            @item.StartDate.ToString("dd.MM.yyyy")
                                        </td>
                                        <td>
                                            @item.EndDate.ToString("dd.MM.yyyy")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>